{
  "manifest_version": 3,
  "name": "CPHB iHOMIS+ Realtime Cloud Sync",
  "version": "1.0.0",
  "description": "Auto-syncs live Inpatient, Emergency, and Outpatient encounters from iHOMIS+ to CPHB Rapid Emergency Alert Cloud System",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CPHB iHOMIS+ Live Sync Status"
  }
}
